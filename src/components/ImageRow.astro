---
const images = [
  "https://via.assets.so/album.png?id=1&q=95&w=360&h=360&fit=fill",
  "https://via.assets.so/album.png?id=2&q=95&w=360&h=360&fit=fill",
  "https://via.assets.so/album.png?id=3&q=95&w=360&h=360&fit=fill",
  "https://via.assets.so/album.png?id=4&q=95&w=360&h=360&fit=fill",
  "https://via.assets.so/album.png?id=5&q=95&w=360&h=360&fit=fill",
  "https://via.assets.so/album.png?id=6&q=95&w=360&h=360&fit=fill",
];
---

<style>
  .image-row {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 10px;
  }

  .image-row img {
    width: 150px;
    height: 150px;
    object-fit: cover;
    border-radius: 8px;
  }
</style>

<div class="image-row">
  {images.map((img) => (
    <img src={img} alt="Album cover" />
  ))}
</div>
